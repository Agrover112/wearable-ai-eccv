# Copy to .env and fill in. .env is gitignored — never commit real tokens.
# On Colab, bootstrap auto-creates .env from Colab Secrets; you don't edit this by hand there.
HF_TOKEN=
GH_TOKEN=
WANDB_API_KEY=

# Optional runtime paths.
SCRATCH_CACHE_ROOT=/path/to/cache
FRAME_AUDIT_DIR=/path/to/frame_audits
