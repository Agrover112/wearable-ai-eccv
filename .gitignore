# ── Heavy / regenerable data — NEVER in git (re-pulled from HF, cached on Drive) ──
data/
models/
# Ignore outputs/ CONTENTS (use /* so git still descends for the negation below)...
outputs/*
# ...but DO keep the small EDA text outputs (reports, tables, figures) in git:
!outputs/eda/
*.mp4
*.parquet
*.arrow

# ── Secrets ──
.env
*.token
hf_token*
**/secrets*

# ── HF / torch caches ──
.cache/
hf_cache/

# ── Python ──
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# ── OS ──
.DS_Store
